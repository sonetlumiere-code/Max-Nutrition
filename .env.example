# Mercado Pago (opcional: sin estas variables el pago online queda deshabilitado
# y el resto del checkout sigue funcionando).
# Access token del comercio, en "Tus integraciones". Empezar con las
# credenciales de prueba antes de pasar a las productivas.
MP_ACCESS_TOKEN=""
# Clave secreta de la firma del webhook, en "Tus integraciones" > Webhooks.
# Sin ella las notificaciones de pago se descartan.
MP_WEBHOOK_SECRET=""

# Secreto de las tareas programadas (pedidos de las suscripciones semanales).
# Vercel lo envía solo en el encabezado Authorization de sus crons. Sin esta
# variable el endpoint responde 503 y no se genera ningún pedido.
CRON_SECRET=""

